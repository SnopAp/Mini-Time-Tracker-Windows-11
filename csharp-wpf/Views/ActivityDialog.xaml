<Window x:Class="MiniTimeTracker.Views.ActivityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая активность"
        Height="220" Width="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border Background="#EE1E1E24"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="14"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Opacity="0.6" ShadowDepth="4" Color="#000000" />
        </Border.Effect>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="HeaderColorDot" Width="10" Height="10" Fill="#3B82F6" Margin="0,0,8,0"/>
                    <TextBlock Text="Новая активность"
                               Foreground="#F3F4F6"
                               FontSize="13"
                               FontWeight="SemiBold" />
                </StackPanel>

                <Button Content="✕"
                        Click="OnCancelClick"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        Foreground="#9CA3AF"
                        BorderThickness="0"
                        FontSize="11"
                        Cursor="Hand" />
            </Grid>

            <!-- Inputs -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="Название активности" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4" />
                <TextBox x:Name="ActivityNameInput"
                         Background="#22222B"
                         Foreground="#FFFFFF"
                         CaretBrush="#FFFFFF"
                         BorderBrush="#444455"
                         BorderThickness="1"
                         Padding="8,6"
                         FontSize="12"
                         Margin="0,0,0,12"
                         KeyDown="OnInputKeyDown" />

                <TextBlock Text="Цветовой маркер" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,6" />
                <!-- Circular Color Swatches matching Web Prototype -->
                <StackPanel x:Name="ColorSwatchesPanel" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Tag="#3B82F6" Background="#3B82F6" Click="OnColorSwatchClick" Width="26" Height="26" Margin="0,0,6,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="13" BorderBrush="#FFFFFF" BorderThickness="2" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Tag="#10B981" Background="#10B981" Click="OnColorSwatchClick" Width="26" Height="26" Margin="0,0,6,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Tag="#8B5CF6" Background="#8B5CF6" Click="OnColorSwatchClick" Width="26" Height="26" Margin="0,0,6,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Tag="#F59E0B" Background="#F59E0B" Click="OnColorSwatchClick" Width="26" Height="26" Margin="0,0,6,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Tag="#EF4444" Background="#EF4444" Click="OnColorSwatchClick" Width="26" Height="26" Margin="0,0,6,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Tag="#06B6D4" Background="#06B6D4" Click="OnColorSwatchClick" Width="26" Height="26" Margin="0,0,6,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Tag="#EC4899" Background="#EC4899" Click="OnColorSwatchClick" Width="26" Height="26" Margin="0,0,6,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Action buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Отмена"
                        Click="OnCancelClick"
                        Background="Transparent"
                        Foreground="#9CA3AF"
                        BorderThickness="0"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Cursor="Hand" />

                <Button Content="Создать"
                        Click="OnSaveClick"
                        Background="#2563EB"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Padding="16,6"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
