<Window x:Class="MiniTimeTracker.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История сессий"
        Height="380" Width="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border Background="#EE1E1E24"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="14"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Opacity="0.6" ShadowDepth="4" Color="#000000" />
        </Border.Effect>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.2 3.2.8-1.3-4.5-2.7V7z"
                          Fill="#60A5FA" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TitleText"
                               Text="История сессий"
                               Foreground="#F3F4F6"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Content="✕"
                        Click="OnCloseClick"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        Foreground="#9CA3AF"
                        BorderThickness="0"
                        FontSize="12"
                        Cursor="Hand" />
            </Grid>

            <!-- Список сессий -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SessionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1A1A22"
                                    BorderBrush="#22FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,0,0,8"
                                    Padding="10,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Название активности -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                                              Fill="#34D399" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding ActivityName}"
                                                   Foreground="#F3F4F6"
                                                   FontWeight="SemiBold"
                                                   FontSize="12" />
                                    </StackPanel>

                                    <!-- Плашка длительности HH:mm:ss -->
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Background="#1E293B"
                                            BorderBrush="#38BDF8"
                                            BorderThickness="0.5"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FormattedDuration}"
                                                   Foreground="#38BDF8"
                                                   FontFamily="Consolas, Segoe UI"
                                                   FontWeight="Bold"
                                                   FontSize="11" />
                                    </Border>

                                    <!-- Дата и интервал времени -->
                                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding StartTime, StringFormat='{}{0:dd.MM.yyyy}'}"
                                                   Foreground="#9CA3AF"
                                                   FontSize="10" />

                                        <TextBlock Grid.Column="1"
                                                   Foreground="#9CA3AF"
                                                   FontSize="10">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:HH:mm:ss} — {1:HH:mm:ss}">
                                                    <Binding Path="StartTime.LocalDateTime" />
                                                    <Binding Path="EndTime.LocalDateTime" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyNotice"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="Завершённых сессий пока нет"
                           Foreground="#9CA3AF"
                           FontSize="12"
                           FontWeight="Medium"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Запустите и остановите таймер, чтобы сохранить первую запись."
                           Foreground="#6B7280"
                           FontSize="11"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Подвал -->
            <Button Grid.Row="2"
                    Content="Закрыть"
                    Click="OnCloseClick"
                    Background="#2A2A35"
                    Foreground="#F3F4F6"
                    BorderThickness="0"
                    Padding="14,6"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
