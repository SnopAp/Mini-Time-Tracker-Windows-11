<Window x:Class="MiniTimeTracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:MiniTimeTracker.ViewModels"
        mc:Ignorable="d"
        Title="Mini Time Tracker"
        Height="76" Width="290"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="{Binding IsTopmost, Mode=OneWay}"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown"
        MouseEnter="OnWindowMouseEnter"
        MouseLeave="OnWindowMouseLeave"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing">

    <Window.Resources>
        <!-- Windows 11 Fluent Colors matching Web Prototype -->
        <SolidColorBrush x:Key="WidgetBgBrush" Color="#EE1E1E24" />
        <SolidColorBrush x:Key="WidgetBorderBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF" />
        <SolidColorBrush x:Key="HoverButtonBg" Color="#22FFFFFF" />

        <!-- Icon Button Style -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverButtonBg}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round Action Button (Start / Stop) -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="False">
        <!-- Выступающий язычок (Edge Peek Tab) при сворачивании к правому краю экрана -->
        <!-- Расположен у левого края окна, чтобы оставаться на экране при сдвиге вправо -->
        <Border x:Name="EdgePeekTab"
                Width="14" Height="58"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="#3B82F6"
                CornerRadius="6,0,0,6"
                Opacity="0"
                IsHitTestVisible="False"
                Cursor="Hand"
                MouseEnter="OnEdgePeekTabMouseEnter"
                ToolTip="Развернуть виджет"
                Margin="0,0,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Opacity="0.5" ShadowDepth="0" Color="#3B82F6"/>
            </Border.Effect>
            <!-- Белая полоска внутри язычка, точно как в веб-прототипе -->
            <Border Width="3" Height="28" Background="#CCFFFFFF" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- Основной контейнер виджета с полупрозрачностью и скруглением Windows 11 -->
        <Border x:Name="MainWidgetContainer"
                Background="{StaticResource WidgetBgBrush}"
                BorderBrush="{StaticResource WidgetBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Margin="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.55" ShadowDepth="6" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="10,6,10,6">
                <Grid.RowDefinitions>
                    <!-- Верхний ряд: активность и кнопки управления при наведении -->
                    <RowDefinition Height="22" />
                    <!-- Нижний ряд: таймер и кнопка Start/Stop -->
                    <RowDefinition Height="38" />
                </Grid.RowDefinitions>

                <!-- Верхний ряд: Название активности + выпадающее меню -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Селектор активности в стиле веб-прототипа -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ActivitySelectorBtn"
                                Click="OnActivitySelectorClick"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="2,1"
                                Cursor="Hand"
                                ToolTip="Сменить активность">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="3,1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{StaticResource HoverButtonBg}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Cursor" Value="Arrow" />
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Индикатор цвета активности -->
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding CurrentActivityColorBrush, FallbackValue=#3B82F6}"/>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <TextBlock Text="{Binding CurrentActivityName}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           MaxWidth="130"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <Path Data="M7 10l5 5 5-5z"
                                      Fill="#9CA3AF"
                                      Margin="4,2,0,0"
                                      VerticalAlignment="Center"
                                      Width="7" Height="5"
                                      Stretch="Uniform"
                                      Visibility="{Binding IsRunning, Converter={x:Null}}"/>
                            </StackPanel>
                        </Button>

                        <!-- Всплывающее меню выбора активности (Popup) -->
                        <Popup x:Name="ActivityPopup"
                               PlacementTarget="{Binding ElementName=ActivitySelectorBtn}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="#1F1F26"
                                    BorderBrush="#33FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4"
                                    MinWidth="170"
                                    Margin="0,4,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" Opacity="0.5" ShadowDepth="4" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Activities}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="OnSelectActivityItemClick"
                                                        Tag="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="6,4"
                                                        Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="itemBorder" Property="Background" Value="#333B82F6" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                                            <Ellipse.Fill>
                                                                <SolidColorBrush Color="#3B82F6"/>
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Name}" Foreground="#E5E7EB" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Background="#22FFFFFF" Margin="0,3" />

                                    <Button Click="OnNewActivityFromPopupClick"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="6,4"
                                            Cursor="Hand"
                                            HorizontalContentAlignment="Left">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="addBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="addBorder" Property="Background" Value="{StaticResource HoverButtonBg}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="+" Foreground="#60A5FA" FontWeight="Bold" Margin="0,0,6,0" FontSize="11" />
                                            <TextBlock Text="Новая активность..." Foreground="#60A5FA" FontSize="11" FontWeight="Medium" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <!-- Панель управления при наведении (Hover Controls с векторными иконками) -->
                    <StackPanel x:Name="HoverControlsPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Opacity="0"
                                VerticalAlignment="Center">
                        
                        <!-- Закрепление поверх всех окон (Pin) -->
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ToggleTopmostCommand}"
                                ToolTip="Закрепить поверх всех окон"
                                Margin="0,0,1,0">
                            <Path Data="M16 12V4H17V2H7V4H8V12L6 14V16H11V22H13V16H18V14L16 12Z"
                                  Fill="{Binding IsTopmost, Converter={x:Null}, FallbackValue=#9CA3AF}"
                                  Stretch="Uniform" Width="10" Height="10">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="#9CA3AF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                                <Setter Property="Fill" Value="#60A5FA"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <!-- Добавить новую активность (+) -->
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding AddActivityCommand}"
                                ToolTip="Создать новую активность"
                                Margin="0,0,1,0">
                            <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                                  Fill="#9CA3AF"
                                  Stretch="Uniform" Width="11" Height="11"/>
                        </Button>

                        <!-- История сессий (History) -->
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ShowHistoryCommand}"
                                ToolTip="История сессий"
                                Margin="0,0,1,0">
                            <Path Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.2 3.2.8-1.3-4.5-2.7V7z"
                                  Fill="#9CA3AF"
                                  Stretch="Uniform" Width="11" Height="11"/>
                        </Button>

                        <!-- Скрытие у края экрана (Edge Dock) -->
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ToggleEdgeDockCommand}"
                                ToolTip="Прикрепить к правому краю экрана (автоскрытие)"
                                Margin="0,0,1,0">
                            <Path Data="M4 14h6v6h-2v-4H4v-2zm10 4v-4h6v2h-4v4h-2zM4 10V4h2v4h4v2H4zm14-4V4h2v6h-6V8h4V6z"
                                  Stretch="Uniform" Width="11" Height="11">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="#9CA3AF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEdgeDocked}" Value="True">
                                                <Setter Property="Fill" Value="#34D399"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <!-- Закрыть приложение (Close) -->
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding CloseCommand}"
                                ToolTip="Закрыть"
                                Margin="1,0,0,0">
                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z"
                                  Fill="#9CA3AF"
                                  Stretch="Uniform" Width="9" Height="9"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Нижний ряд: Таймер и кнопка Play / Stop -->
                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Большой таймер в моноширинном начертании -->
                    <TextBlock Text="{Binding FormattedTime}"
                               Foreground="#FFFFFF"
                               FontFamily="Consolas, Segoe UI Variable Display, Segoe UI"
                               FontSize="23"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="2,0,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="4" Opacity="0.3" ShadowDepth="1" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Кнопка запуска / остановки отсчёта -->
                    <Button Grid.Column="1"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding ToggleStartStopCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                <Setter Property="Background" Value="#10B981" />
                                <Setter Property="ToolTip" Value="Начать отсчёт" />
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <!-- Треугольник Play ▶ -->
                                        <Polygon Points="0,0 0,13 11,6.5" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Background" Value="#EF4444" />
                                        <Setter Property="ToolTip" Value="Остановить отсчёт" />
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <!-- Квадрат Stop ⏹ со скруглением -->
                                                <Rectangle Width="12" Height="12" Fill="#FFFFFF" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
